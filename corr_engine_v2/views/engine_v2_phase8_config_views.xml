<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Engine Stage Templates -->
    <record id="view_corr_engine_stage_template_list" model="ir.ui.view">
      <field name="name">corr.engine.stage.template.list</field>
      <field name="model">corr.engine.stage.template</field>
      <field name="arch" type="xml">
        <list string="Engine Stage Templates">
          <field name="code"/>
          <field name="name"/>
          <field name="stage_type_id"/>
          <field name="sequence"/>
          <field name="consider_slitting_options"/>
          <field name="drives_layout_selection"/>
          <field name="is_entry_stage"/>
          <field name="is_fg_stage"/>
          <field name="is_optional"/>
          <field name="advanced_overrides" groups="base.group_system" optional="hide"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_corr_engine_stage_template_form" model="ir.ui.view">
      <field name="name">corr.engine.stage.template.form</field>
      <field name="model">corr.engine.stage.template</field>
      <field name="arch" type="xml">
        <form string="Engine Stage Template">
          <header>
            <button name="action_seed_contract_defaults"
                    type="object"
                    string="Apply Contract Defaults"
                    class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <field name="code" readonly="id"/>
              <field name="name"/>
              <field name="stage_type_id"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
            <group string="Advanced / Technical" groups="base.group_system">
              <field name="advanced_overrides"/>
              <field name="stage_type" readonly="1"/>
              <field name="capability_id" readonly="1"/>
              <field name="execution_type"/>
              <field name="output_kind"/>
              <field name="output_stock_behavior"/>
              <field name="bom_mapping_policy"/>
              <field name="quantity_profile_id"/>
              <field name="default_quantity_basis"/>
              <field name="default_cost_basis"/>
            </group>
            <group string="Behaviour">
              <field name="consumes_previous_output"/>
              <field name="previous_output_required"/>
              <field name="consider_slitting_options"/>
              <field name="drives_layout_selection"/>
              <field name="is_entry_stage"/>
              <field name="is_fg_stage"/>
              <field name="is_optional"/>
              <field name="merge_group_key"/>
            </group>
            <notebook>
              <page string="Advanced Contract" groups="base.group_system">
                <group string="Flow Behaviour">
                  <field name="can_be_terminal"/>
                </group>
                <group string="Allowed Inputs">
                  <field name="input_rule_ids" nolabel="1">
                    <list editable="bottom">
                      <field name="sequence" widget="handle"/>
                      <field name="role_id"/>
                      <field name="requirement"/>
                      <field name="source"/>
                      <field name="priority"/>
                      <field name="note"/>
                    </list>
                  </field>
                </group>
              </page>
              <page string="I/O Definitions" groups="base.group_system">
                <field name="io_template_ids" nolabel="1">
                  <list editable="bottom">
                    <field name="input_quantity_node_key"/>
                    <field name="output_quantity_node_key"/>
                    <field name="yield_factor"/>
                    <field name="loss_type"/>
                    <field name="active"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_corr_engine_stage_template" model="ir.actions.act_window">
      <field name="name">Engine Stage Templates</field>
      <field name="res_model">corr.engine.stage.template</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="view_corr_engine_stage_template_list"/>
    </record>

    <menuitem id="menu_corr_engine_stage_template"
              name="Engine Stage Templates"
              parent="corr_mrp_bridge.menu_mrp_corr_bridge_engine_admin"
              action="action_corr_engine_stage_template"
              sequence="15"
              groups="corrugation_formula_engine_v2.group_corr_manager"/>

    <!-- Engine Stage Capabilities -->
    <record id="view_corr_engine_stage_capability_list" model="ir.ui.view">
      <field name="name">corr.engine.stage.capability.list</field>
      <field name="model">corr.engine.stage.capability</field>
      <field name="arch" type="xml">
        <list string="Engine Stage Capabilities">
          <header>
            <button name="action_seed_default_capabilities"
                    type="object"
                    string="Seed Default Capabilities"
                    class="oe_highlight"/>
          </header>
          <field name="code"/>
          <field name="name"/>
          <field name="execution_type"/>
          <field name="default_output_kind"/>
          <field name="default_output_stock_behavior"/>
          <field name="default_bom_mapping_policy"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_corr_engine_stage_capability_form" model="ir.ui.view">
      <field name="name">corr.engine.stage.capability.form</field>
      <field name="model">corr.engine.stage.capability</field>
      <field name="arch" type="xml">
        <form string="Engine Stage Capability">
          <header>
            <button name="action_seed_default_capabilities"
                    type="object"
                    string="Seed Default Capabilities"
                    class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <field name="code"/>
              <field name="name"/>
              <field name="execution_type"/>
              <field name="active"/>
            </group>
            <group string="Defaults">
              <field name="default_output_kind"/>
              <field name="default_output_stock_behavior"/>
              <field name="default_bom_mapping_policy"/>
              <field name="default_quantity_profile_id"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_corr_engine_stage_capability" model="ir.actions.act_window">
      <field name="name">Engine Stage Capabilities</field>
      <field name="res_model">corr.engine.stage.capability</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="view_corr_engine_stage_capability_list"/>
    </record>

    <menuitem id="menu_corr_engine_stage_capability"
              name="Engine Stage Capabilities"
              parent="corr_mrp_bridge.menu_mrp_corr_bridge_engine_admin"
              action="action_corr_engine_stage_capability"
              sequence="14"
              groups="base.group_system"/>

    <record id="view_corr_stage_type_list_engine_v2" model="ir.ui.view">
      <field name="name">corr.stage.type.list.engine.v2</field>
      <field name="model">corr.stage.type</field>
      <field name="inherit_id" ref="corr_mrp_bridge.view_corr_stage_type_list"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='default_operation_type_id']" position="after">
          <field name="capability_id" groups="base.group_system" optional="hide"/>
          <field name="default_stage_type" optional="hide"/>
          <field name="default_execution_type" optional="hide"/>
          <field name="default_output_kind" optional="hide"/>
          <field name="default_output_stock_behavior" optional="hide"/>
          <field name="default_bom_mapping_policy" optional="hide"/>
          <field name="default_quantity_profile_id" optional="hide"/>
        </xpath>
      </field>
    </record>

    <record id="view_corr_stage_type_form_engine_v2" model="ir.ui.view">
      <field name="name">corr.stage.type.form.engine.v2</field>
      <field name="model">corr.stage.type</field>
      <field name="inherit_id" ref="corr_mrp_bridge.view_corr_stage_type_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='default_operation_type_id']" position="after">
          <field name="capability_id" groups="base.group_system"/>
          <field name="default_stage_type"/>
          <field name="default_execution_type"/>
          <field name="default_output_kind"/>
          <field name="default_output_stock_behavior"/>
          <field name="default_bom_mapping_policy"/>
          <field name="default_quantity_profile_id"/>
        </xpath>
      </field>
    </record>

    <record id="view_corr_engine_routing_profile_form_engine_v2_stage_template" model="ir.ui.view">
      <field name="name">corr.engine.routing.profile.form.engine.v2.stage.template</field>
      <field name="model">corr.engine.routing.profile</field>
      <field name="inherit_id" ref="corr_mrp_bridge.view_corr_engine_routing_profile_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='stage_ids']/list/field[@name='stage_code']" position="replace">
          <field name="stage_template_id" string="Stage Template"/>
          <field name="stage_code" string="Technical Stage Code" groups="base.group_system" readonly="1" optional="hide"/>
        </xpath>
        <xpath expr="//field[@name='stage_ids']/list/field[@name='stage_type']" position="attributes">
          <attribute name="string">Routing Line Type</attribute>
          <attribute name="readonly">1</attribute>
        </xpath>
      </field>
    </record>

