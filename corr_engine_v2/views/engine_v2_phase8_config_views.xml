    <!-- Engine V2 Contract Seeding / Normalisation Wizard -->
    <record id="view_corr_engine_v2_contract_seed_wizard_form" model="ir.ui.view">
      <field name="name">corr.engine.v2.contract.seed.wizard.form</field>
      <field name="model">corr.engine.v2.contract.seed.wizard</field>
      <field name="arch" type="xml">
        <form string="Engine V2 Contract Seeding">
          <sheet>
            <group string="Actions">
              <field name="seed_capabilities"/>
              <field name="seed_input_roles"/>
              <field name="normalise_stage_templates"/>
            </group>
            <footer>
              <button string="Run"
                      name="action_run"
                      type="object"
                      class="btn-primary"/>
              <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_corr_engine_v2_contract_seed_wizard" model="ir.actions.act_window">
      <field name="name">Engine V2 Contract Seeding</field>
      <field name="res_model">corr.engine.v2.contract.seed.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_corr_engine_v2_contract_seed_wizard_form"/>
      <field name="target">new</field>
    </record>

    <menuitem id="menu_corr_engine_v2_contract_seed_wizard"
