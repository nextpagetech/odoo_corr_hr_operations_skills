      <field name="name">corr.compute.wizard.form.inherit.bridge</field>
      <field name="model">corr.compute.wizard</field>
      <field name="inherit_id" ref="corrugation_formula_engine_v2.view_corr_compute_wizard_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='result_json']" position="attributes">
          <attribute name="groups">base.group_system</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>

