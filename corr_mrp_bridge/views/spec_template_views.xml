<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_corr_spec_template_form_finishing" model="ir.ui.view">
      <field name="name">corr.spec.template.form.corr_mrp_bridge.finishing</field>
      <field name="model">corr.spec.template</field>
      <field name="inherit_id" ref="corrugation_formula_engine_v2.view_corr_spec_template_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='locking_type_id']" position="after">
          <field
            name="corr_extra_finishing_operation_ids"
            widget="many2many_tags"
            options="{'no_create_edit': True}"
          />
          <field name="stage_mapping_id" options="{'no_create_edit': True}"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
