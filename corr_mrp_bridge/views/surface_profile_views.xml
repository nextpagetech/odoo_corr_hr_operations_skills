<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_corr_engine_surface_profile_tree" model="ir.ui.view">
      <field name="name">corr.engine.surface.profile.tree</field>
      <field name="model">corr.engine.surface.profile</field>
      <field name="arch" type="xml">
        <list string="Surface Profiles">
          <field name="name"/>
          <field name="printing_required"/>
          <field name="print_process"/>
          <field name="print_colors"/>
          <field name="top_sheet_mode"/>
          <field name="lamination_required"/>
        </list>
      </field>
    </record>

    <record id="view_corr_engine_surface_profile_form" model="ir.ui.view">
      <field name="name">corr.engine.surface.profile.form</field>
      <field name="model">corr.engine.surface.profile</field>
      <field name="arch" type="xml">
        <form string="Surface Profile">
          <group string="Surface / Printing">
            <field name="name"/>
          </group>
          <notebook>
            <page string="Printing">
              <group>
                <field name="printing_required"/>
                <field name="print_process"/>
                <field name="print_colors"/>
                <field name="print_coverage_percent"/>
              </group>
            </page>
            <page string="Top Sheet">
              <group>
                <field name="top_sheet_mode"/>
                <field name="top_sheet_product_id"/>
                <field name="top_sheet_roll_code" invisible="top_sheet_mode != 'roll'"/>
              </group>
            </page>
            <page string="Lamination">
              <group>
                <field name="lamination_required"/>
                <field name="lamination_type_id"/>
                <field name="lamination_side"/>
              </group>
            </page>
          </notebook>
        </form>
      </field>
    </record>

    <record id="action_corr_engine_surface_profile" model="ir.actions.act_window">
      <field name="name">Surface Profiles</field>
      <field name="res_model">corr.engine.surface.profile</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="corr_menu_engine_surface_profile"
              name="Surface Profiles"
              parent="menu_mrp_corr_bridge_root"
              action="action_corr_engine_surface_profile"
              sequence="30"
              groups="corrugation_formula_engine_v2.group_corr_manager"/>
  </data>
</odoo>
