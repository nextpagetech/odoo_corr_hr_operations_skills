<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Views -->
    <record id="view_corr_material_product_map_list" model="ir.ui.view">
      <field name="name">corr.material.product.map.list</field>
      <field name="model">corr.material.product.map</field>
      <field name="arch" type="xml">
        <list string="Material to Product Mappings" editable="bottom">
          <field name="kind"/>
          <field name="flute_code"/>
          <field name="gsm_min"/>
          <field name="gsm_max"/>
          <field name="engine_code"/>
          <field name="product_id"/>
          <field name="uom_id"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_corr_material_product_map_form" model="ir.ui.view">
      <field name="name">corr.material.product.map.form</field>
      <field name="model">corr.material.product.map</field>
      <field name="arch" type="xml">
        <form string="Material Mapping">
          <group>
            <field name="kind"/>
            <field name="flute_code"/>
            <field name="gsm_min"/>
            <field name="gsm_max"/>
            <field name="engine_code"/>
          </group>
          <group>
            <field name="product_id"/>
            <field name="uom_id"/>
            <field name="active"/>
          </group>
        </form>
      </field>
    </record>

    <!-- Action first, then menus -->
    <record id="action_corr_material_map" model="ir.actions.act_window">
      <field name="name">Material Mapping</field>
      <field name="res_model">corr.material.product.map</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Menus under Corrugation Tools -->
    <menuitem id="menu_corr_bridge_root" name="MRP Bridge" parent="corrugation_formula_engine_v2.menu_corr_tools" sequence="90" groups="corrugation_formula_engine_v2.group_corr_manager"/>
    <menuitem id="menu_corr_material_map" name="Material Mapping" parent="menu_corr_bridge_root" action="corr_mrp_bridge.action_corr_material_map" sequence="10" groups="corrugation_formula_engine_v2.group_corr_manager"/>
  </data>
</odoo>
