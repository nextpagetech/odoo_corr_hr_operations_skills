<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Show Product Role on product template (readable by all, editable by product managers) -->
        <record id="view_product_template_form_product_role_corr" model="ir.ui.view">
            <field name="name">product.template.form.product.role.corr</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="product_role" groups="product.group_product_manager"/>
                    <field name="stage_type_id" groups="product.group_product_manager"
                           invisible="product_role != 'sfg'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
