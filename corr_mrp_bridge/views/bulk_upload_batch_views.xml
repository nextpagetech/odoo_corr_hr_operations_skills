<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_corr_bulk_upload_batch_list" model="ir.ui.view">
      <field name="name">corr.bulk.upload.batch.list</field>
      <field name="model">corr.bulk.upload.batch</field>
      <field name="arch" type="xml">
        <list>
          <field name="imported_at"/>
          <field name="name"/>
          <field name="total_rows"/>
          <field name="success_count"/>
          <field name="auto_fixed_count"/>
          <field name="failed_count"/>
          <field name="state"/>
        </list>
      </field>
    </record>

    <record id="view_corr_bulk_upload_batch_form" model="ir.ui.view">
      <field name="name">corr.bulk.upload.batch.form</field>
      <field name="model">corr.bulk.upload.batch</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_retry_failed_boms" type="object" string="Retry Failed BoMs" class="btn-primary"/>
            <button name="action_download_error_report" type="object" string="Download Error Report"/>
            <field name="state" widget="statusbar" statusbar_visible="success,partial,failed"/>
          </header>
          <sheet>
            <group>
              <field name="name"/>
              <field name="imported_at" readonly="1"/>
            </group>
            <group>
              <field name="total_rows" readonly="1"/>
              <field name="success_count" readonly="1"/>
              <field name="auto_fixed_count" readonly="1"/>
              <field name="failed_count" readonly="1"/>
            </group>
            <notebook>
              <page string="Rows">
                <field name="line_ids" readonly="1">
                  <list decoration-success="status == 'success'" decoration-info="status == 'auto_fixed'" decoration-danger="status == 'failed'">
                    <field name="excel_row"/>
                    <field name="product_code"/>
                    <field name="product_name"/>
                    <field name="product_tmpl_id"/>
                    <field name="status"/>
                    <field name="failure_stage"/>
                    <field name="error_message"/>
                    <field name="action_required"/>
                    <field name="spec_id"/>
                    <field name="bom_id"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_corr_bulk_upload_line_search" model="ir.ui.view">
      <field name="name">corr.bulk.upload.line.search</field>
      <field name="model">corr.bulk.upload.line</field>
      <field name="arch" type="xml">
        <search>
          <field name="product_code"/>
          <field name="product_name"/>
          <field name="product_tmpl_id"/>
          <filter name="success" string="Success" domain="[('status','=','success')]"/>
          <filter name="auto_fixed" string="Auto Fixed" domain="[('status','=','auto_fixed')]"/>
          <filter name="failed" string="Failed" domain="[('status','=','failed')]"/>
          <separator/>
          <group expand="0" string="Group By">
            <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
            <filter name="group_failure_stage" string="Failure Stage" context="{'group_by':'failure_stage'}"/>
            <filter name="group_batch" string="Batch" context="{'group_by':'batch_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="view_corr_bulk_upload_line_list" model="ir.ui.view">
      <field name="name">corr.bulk.upload.line.list</field>
      <field name="model">corr.bulk.upload.line</field>
      <field name="arch" type="xml">
        <list decoration-success="status == 'success'" decoration-info="status == 'auto_fixed'" decoration-danger="status == 'failed'">
          <field name="batch_id"/>
          <field name="excel_row"/>
          <field name="product_code"/>
          <field name="product_name"/>
          <field name="product_tmpl_id"/>
          <field name="status"/>
          <field name="failure_stage"/>
          <field name="error_message"/>
          <field name="action_required"/>
          <field name="spec_id"/>
          <field name="bom_id"/>
        </list>
      </field>
    </record>

    <record id="action_corr_bulk_upload_batch" model="ir.actions.act_window">
      <field name="name">Bulk Upload Results</field>
      <field name="res_model">corr.bulk.upload.batch</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_corr_bulk_upload_line" model="ir.actions.act_window">
      <field name="name">Bulk Upload Result Lines</field>
      <field name="res_model">corr.bulk.upload.line</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_corr_bulk_upload_line_search"/>
    </record>

    <menuitem id="menu_corr_bulk_upload_batch"
              name="Bulk Upload Results"
              parent="menu_mrp_corr_bridge_debug"
              action="action_corr_bulk_upload_batch"
              sequence="10"
              groups="corrugation_formula_engine_v2.group_corr_manager"/>

    <menuitem id="menu_corr_bulk_upload_line"
              name="Bulk Upload Result Lines"
              parent="menu_mrp_corr_bridge_debug"
              action="action_corr_bulk_upload_line"
              sequence="11"
              groups="corrugation_formula_engine_v2.group_corr_manager"/>
  </data>
</odoo>
