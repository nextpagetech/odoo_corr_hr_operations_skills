<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_corr_sfg_mass_tag_wizard" model="ir.ui.view">
            <field name="name">corr.sfg.mass.tag.wizard.form</field>
            <field name="model">corr.sfg.mass.tag.wizard</field>
            <field name="arch" type="xml">
                <form string="Mass Tag SFG Products">
                    <group>
                        <field name="apply_role"/>
                    </group>
                    <group string="Filters">
                        <field name="only_corr_sfg_key"/>
                        <field name="name_contains"/>
                        <field name="has_bom"/>
                        <field name="active_only"/>
                    </group>
                    <group string="Preview">
                        <field name="preview_count" readonly="1"/>
                        <field name="preview_domain" readonly="1" widget="text"/>
                        <field name="log_message" readonly="1" widget="text"/>
                    </group>
                    <footer>
                        <button name="action_preview" type="object" string="Preview"
                                class="btn-secondary"/>
                        <button name="action_apply" type="object" string="Apply"
                                class="btn-primary"/>
                        <button string="Close" special="cancel" class="btn-link"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_corr_sfg_mass_tag_wizard" model="ir.actions.act_window">
            <field name="name">Mass Tag SFG Products</field>
            <field name="res_model">corr.sfg.mass.tag.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_corr_sfg_mass_tag_wizard"/>
            <field name="target">new</field>
        </record>

        <menuitem id="corr_menu_sfg_mass_tag"
                  name="Mass Tag SFG Products"
                  parent="corr_menu_sfg_inventory_root"
                  action="action_corr_sfg_mass_tag_wizard"
                  groups="product.group_product_manager"
                  sequence="50"/>
    </data>
</odoo>

